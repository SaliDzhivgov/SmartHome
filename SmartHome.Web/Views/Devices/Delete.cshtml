
@model DeviceDetailsViewModel
@{
    ViewData["Title"] = "Изтриване на устройство";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="sh-panel text-center sh-fade-in">
            <i class="bi bi-trash3 display-5 text-danger"></i>
            <h1 class="h4 fw-bold mt-3">Изтриване на устройство</h1>
            <p class="text-muted">
                Сигурни ли сте, че искате да изтриете <strong>@Model.Name</strong>
                (<code>@Model.SerialNumber</code>) от стая „@Model.RoomName“? Това действие не може да бъде отменено.
            </p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-2 mt-4">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Да, изтрий</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отказ</a>
            </form>
        </div>
    </div>
</div>