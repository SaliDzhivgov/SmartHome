
@model DeviceDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="sh-page-header sh-fade-in">
    <div>
        <div class="sh-eyebrow">
            <a asp-action="Index" class="text-reset text-decoration-none">Устройства</a> / @Model.CategoryName
        </div>
        <h1 class="display-6">@Model.Name</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark"><i class="bi bi-pencil"></i> Редактирай</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Изтрий</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="sh-panel text-center @(Model.IsOn ? "is-on" : "is-off")">
            <span class="sh-device-icon mx-auto mb-3" style="width: 5rem; height: 5rem; font-size: 2.2rem;">
                <i class="bi @Model.CategoryIcon"></i>
            </span>
            <div class="mb-3">
                <span class="badge sh-status-badge"><span class="sh-dot"></span>@(Model.IsOn ? "Включено" : "Изключено")</span>
            </div>
            <div class="sh-power fs-4 mb-3"><i class="bi bi-lightning-charge-fill"></i> @Model.PowerWatts.ToString("0.#") W</div>
            <form asp-action="Toggle" asp-route-id="@Model.Id" method="post">
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                <button type="submit" class="btn sh-toggle-btn w-100">
                    <i class="bi bi-power"></i> @(Model.IsOn ? "Изключи" : "Включи")
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="sh-panel">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted fw-semibold">Сериен номер</dt>
                <dd class="col-sm-8"><code>@Model.SerialNumber</code></dd>

                <dt class="col-sm-4 text-muted fw-semibold">Стая</dt>
                <dd class="col-sm-8">
                    <a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.RoomId">@Model.RoomName</a>
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">Категория</dt>
                <dd class="col-sm-8"><i class="bi @Model.CategoryIcon"></i> @Model.CategoryName</dd>

                <dt class="col-sm-4 text-muted fw-semibold">Производител</dt>
                <dd class="col-sm-8">
                    @Model.ManufacturerName
                    @if (!string.IsNullOrEmpty(Model.ManufacturerWebsite))
                    {
                        <a href="@Model.ManufacturerWebsite" target="_blank" rel="noopener" class="ms-1"><i class="bi bi-box-arrow-up-right"></i></a>
                    }
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">Инсталирано на</dt>
                <dd class="col-sm-8">@Model.InstalledOn.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-4 text-muted fw-semibold">Бележки</dt>
                <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
            </dl>
        </div>
    </div>
</div>