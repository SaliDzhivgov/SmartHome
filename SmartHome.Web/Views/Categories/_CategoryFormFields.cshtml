@model CategoryFormModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger sh-alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="напр. Градина" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Icon" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i id="icon-preview" class="bi @Model.Icon"></i></span>
            <select asp-for="Icon" asp-items="@(new SelectList(CategoryIcons.All, "Key", "Value"))" class="form-select"></select>
        </div>
        <span asp-validation-for="Icon" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="По желание"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>