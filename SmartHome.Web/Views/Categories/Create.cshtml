@model CategoryFormModel
@{
    ViewData["Title"] = "Нова категория";
}

<div class="sh-page-header sh-fade-in">
    <div>
        <div class="sh-eyebrow">Категории</div>
        <h1 class="display-6">Нова категория</h1>
    </div>
</div>

<div class="sh-panel">
    <form asp-action="Create" method="post" novalidate>
        <partial name="_CategoryFormFields" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Запази</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}