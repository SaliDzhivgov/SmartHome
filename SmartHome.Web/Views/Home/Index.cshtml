@model DashboardViewModel
@{
    ViewData["Title"] = "Табло";
}

<div class="sh-page-header sh-fade-in">
    <div>
        <div class="sh-eyebrow">Добре дошли у дома</div>
        <h1 class="display-6">Табло на умния дом</h1>
    </div>
    <a asp-controller="Devices" asp-action="Index" class="btn btn-outline-dark">
        Всички устройства <i class="bi bi-arrow-right"></i>
    </a>
</div>

<div class="row g-3 mb-5">
    <div class="col-6 col-lg-3">
        <div class="sh-stat sh-stat-dark">
            <div class="sh-stat-label">Текуща мощност</div>
            <div class="sh-stat-value">@Model.ActivePowerWatts.ToString("0.#") W</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sh-stat">
            <div class="sh-stat-label">Включени устройства</div>
            <div class="sh-stat-value">@Model.ActiveDevicesCount <span class="fs-6 text-muted">/ @Model.DevicesCount</span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sh-stat">
            <div class="sh-stat-label">Устройства</div>
            <div class="sh-stat-value">@Model.DevicesCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="sh-stat">
            <div class="sh-stat-label">Стаи</div>
            <div class="sh-stat-value">@Model.RoomsCount</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 fw-bold m-0">Стаи</h2>
    <a asp-controller="Rooms" asp-action="Create" class="small fw-semibold">+ Нова стая</a>
</div>
<div class="row g-3 mb-5">
    @foreach (var room in Model.Rooms)
    {
        int percent = room.DeviceCount == 0 ? 0 : room.ActiveDeviceCount * 100 / room.DeviceCount;

        <div class="col-sm-6 col-lg-4">
            <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.Id" class="sh-room-tile">
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">@room.Name</span>
                    <span class="small text-muted">етаж @room.Floor</span>
                </div>
                <div class="small text-muted mt-1 mb-3">
                    @room.ActiveDeviceCount от @room.DeviceCount включени · @room.ActivePowerWatts.ToString("0.#") W
                </div>
                <div class="progress sh-progress">
                    <div class="progress-bar" style="width: @percent%"></div>
                </div>
            </a>
        </div>
    }
</div>

<h2 class="h5 fw-bold mb-3">Последно инсталирани</h2>
@if (!Model.RecentDevices.Any())
{
    <div class="sh-panel sh-empty">
        <i class="bi bi-cpu"></i>
        <p class="mt-2">Все още няма устройства.</p>
        <a asp-controller="Devices" asp-action="Create" class="btn btn-primary">Добави първото</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var device in Model.RecentDevices)
        {
            <div class="col-sm-6 col-lg-3">
                <partial name="_DeviceCard" model="device" />
            </div>
        }
    </div>
}