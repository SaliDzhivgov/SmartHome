@model DeviceCardViewModel
@{
    string returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="card sh-device-card h-100 @(Model.IsOn ? "is-on" : "is-off")">
    <div class="card-body d-flex flex-column">
        <div class="d-flex align-items-start justify-content-between mb-3">
            <span class="sh-device-icon"><i class="bi @Model.CategoryIcon"></i></span>
            <span class="badge sh-status-badge">
                <span class="sh-dot"></span>@(Model.IsOn ? "Включено" : "Изключено")
            </span>
        </div>

        <h3 class="h6 fw-bold mb-1">
            <a asp-controller="Devices" asp-action="Details" asp-route-id="@Model.Id" class="text-reset text-decoration-none">
                @Model.Name
            </a>
        </h3>
        <p class="small text-muted mb-3">
            <i class="bi bi-door-open"></i> @Model.RoomName · @Model.ManufacturerName
        </p>

        <div class="mt-auto d-flex align-items-center justify-content-between">
            <span class="sh-power"><i class="bi bi-lightning-charge-fill"></i> @Model.PowerWatts.ToString("0.#") W</span>
            <form asp-controller="Devices" asp-action="Toggle" asp-route-id="@Model.Id" method="post" class="m-0">
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-sm sh-toggle-btn" title="@(Model.IsOn ? "Изключи" : "Включи")">
                    <i class="bi bi-power"></i> @(Model.IsOn ? "Изключи" : "Включи")
                </button>
            </form>
        </div>
    </div>
</div>