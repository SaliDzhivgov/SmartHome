@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="mt-3">Възникна грешка</h1>
    <p class="text-muted">Нещо се обърка при обработката на заявката. Опитайте отново по-късно.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Код на заявката: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Към началото</a>
</div>