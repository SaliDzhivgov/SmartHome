@model ManufacturerFormModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger sh-alert"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="напр. Aqara" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Country" class="form-label"></label>
        <input asp-for="Country" class="form-control" placeholder="напр. Китай" />
        <span asp-validation-for="Country" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Website" class="form-label"></label>
        <input asp-for="Website" type="url" class="form-control" placeholder="https://example.com" />
        <span asp-validation-for="Website" class="text-danger small"></span>
    </div>
</div>